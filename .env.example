# Copy thành .env rồi sửa. Biến môi trường có sẵn được ưu tiên hơn file này.

# ---- thời điểm ----
# Giờ mở phiên dự kiến (giờ VN). Racer bắn khi nhận K04, giờ này chỉ dùng làm mốc:
# kết nối trước RACE_CONNECT_LEAD, spin trước RACE_SPIN_LEAD, bỏ qua K04 sớm hơn RACE_K04_EARLIEST.
RACE_OPEN_TIME=09:00:00
RACE_UTC_OFFSET=+07:00
RACE_CONNECT_LEAD=2m
RACE_SPIN_LEAD=3s
RACE_K04_EARLIEST=10m
# Bật nếu muốn bắn theo đồng hồ khi quá giờ mở mà chưa có K04 (bỏ trống = chỉ chờ K04)
#RACE_FALLBACK_DELAY=500ms
RACE_GIVE_UP_AFTER=5m
RACE_ACK_TIMEOUT=15s

# ---- K04 mở phiên (tag 20005 BoardEvtID) ----
RACE_TRIGGER_STO=AA1
RACE_TRIGGER_STX=BB1
RACE_TRIGGER_UPX=AB1

# ---- lệnh và nhật ký ----
RACE_ORDERS_FILE=orders.csv
RACE_JOURNAL_DIR=journal
RACE_CLORDID_PREFIX=R
RACE_SENDER_SUB_ID=HSC
RACE_CHECK_TICK=true
RACE_HEARTBEAT=30s
# Thread đọc spin non-blocking từ RACE_SPIN_LEAD trước giờ mở tới khi mọi thị trường đã mở.
# Mỗi session bật chiếm trọn một core; ghi đè từng session bằng RACE_<S>_BUSY_POLL.
RACE_BUSY_POLL=true

# ---- session ----
# Session có MARKETS gửi lệnh; không có MARKETS thì chỉ nghe tin (K04).
# RATE: lệnh/giây tối đa trên session. Chưa có số chính thức của sở thì để thấp,
# có số rồi thì đặt thấp hơn hạn mức đó ~5-10%.
RACE_SESSIONS=hose,hnx,hose_md,hnx_md

RACE_HOSE_ADDR=127.0.0.1:30120
RACE_HOSE_SENDER=HOSE01
RACE_HOSE_TARGET=LTHOSE
RACE_HOSE_MARKETS=STO
RACE_HOSE_RATE=50
RACE_HOSE_BURST=1
RACE_HOSE_RESET_SEQ=true
# session lệnh HOSE không nhận K04 (K04 HOSE tới qua VOMGW): không cần spin đọc
RACE_HOSE_BUSY_POLL=false

RACE_HNX_ADDR=127.0.0.1:30122
RACE_HNX_SENDER=HNX01
RACE_HNX_TARGET=LTHNX
RACE_HNX_MARKETS=STX,UPX
RACE_HNX_RATE=50
RACE_HNX_BURST=1
RACE_HNX_RESET_SEQ=true

RACE_HOSE_MD_ADDR=127.0.0.1:30119
RACE_HOSE_MD_SENDER=HOSE02
RACE_HOSE_MD_TARGET=VOMGW
RACE_HOSE_MD_RESET_SEQ=true

RACE_HNX_MD_ADDR=127.0.0.1:30112
RACE_HNX_MD_SENDER=HNX02
RACE_HNX_MD_TARGET=VXMGW
RACE_HNX_MD_RESET_SEQ=true
